# ============================================================================
# RAG Ingestion & Search API — configuration template.
# cp .env.example .env, then replace every <placeholder>.
# Every key maps 1:1 to a field on app/settings.py:Settings.
# Never leave a value blank (KEY=): pydantic-settings reads it as an empty
# string instead of using the default, which breaks startup (int/bool fields)
# or causes silent 404s (AZURE_OPENAI_API_VERSION). Delete or comment out the
# line instead.
# ============================================================================

# ---------- Azure AI Search ----------
# Semantic-ranker usage is billed per search service across all its indexes.
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_API_KEY=<search-admin-key>
AZURE_SEARCH_INDEX=rag-documents

# ---------- Azure OpenAI chat (answers + agentic planner/judge) ----------
AZURE_OPENAI_ENDPOINT=https://<openai-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<openai-api-key>
AZURE_OPENAI_DEPLOYMENT=<chat-deployment-name>
# Informational label only; the code calls the deployment above.
AZURE_OPENAI_MODEL=<chat-model-name>
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# ---------- Azure OpenAI embeddings ----------
# Only if embeddings live in a different resource than chat; when commented
# out, the chat endpoint/key above are used.
# AZURE_OPENAI_EMBEDDING_ENDPOINT=https://<embedding-resource>.openai.azure.com/
# AZURE_OPENAI_EMBEDDING_API_KEY=<embedding-api-key>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<embedding-deployment-name>
# Informational label only; the code calls the deployment above.
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the model AND the index's content_vector field
# (text-embedding-3-small / ada-002 = 1536, text-embedding-3-large = 3072).
EMBEDDING_DIMENSIONS=1536

# ---------- Database (SQLite) ----------
# ./db on the host, bind-mounted at /srv/db. Entrypoint runs alembic on boot.
DATABASE_URL=sqlite+aiosqlite:////srv/db/rag.db

# ---------- Local file storage ----------
# ./storage on the host, bind-mounted at /srv/storage (logs live here too).
STORAGE_DIR=/srv/storage
MAX_UPLOAD_MB=100

# ---------- Chunking ----------
CHUNK_TOKENS=800
CHUNK_OVERLAP=100

# ---------- Query / answer ----------
SEARCH_TOP_K_CHUNKS=30
SEARCH_TOP_K_DOCS=5
CHAT_MAX_CONTEXT_CHUNKS=12

# ---------- Agentic search (POST /query) ----------
# Single-intent questions: 1 search. Multi-intent: 3 parallel sub-queries,
# then up to 2 follow-ups; hard cap AGENTIC_MAX_SEARCHES per request. Each
# search is one semantic query. Set false to always run a single search.
AGENTIC_SEARCH_ENABLED=true
AGENTIC_MAX_SUBQUERIES=3
AGENTIC_MAX_SEARCHES=5
# Chunks per sub-query (0 = SEARCH_TOP_K_CHUNKS).
AGENTIC_SUBQUERY_TOP_K=15
# Planner/judge timeout; on timeout the query degrades to a single search.
AGENTIC_LLM_TIMEOUT_S=20

# ---------- Ingest throughput ----------
# Conservative defaults. For bulk ingest, raise together, e.g.
# INGEST_CONCURRENCY=12, EMBED_BATCH_SIZE=64, EMBED_MAX_INFLIGHT_BATCHES=12,
# SEARCH_MAX_INFLIGHT_UPLOADS=32 (watch for 429s / 503s).
INGEST_CONCURRENCY=2
EMBED_BATCH_SIZE=16
# Process-wide caps on concurrent upstream calls. Lower if you see Azure
# OpenAI 429s or Azure AI Search 503s.
EMBED_MAX_INFLIGHT_BATCHES=4
SEARCH_MAX_INFLIGHT_UPLOADS=4

# ---------- OCR (scanned PDF pages, RapidOCR / ONNX on CPU) ----------
# OCR_ENABLED=false: scanned pages yield no text, so fully scanned PDFs fail
#   with "empty extraction".
# OCR_REJECT_SCANNED=true: scan detection still runs, but any doc containing a
#   scanned page is rejected instead of OCR'd. Fast text-only first pass:
#   OCR_ENABLED=false + OCR_REJECT_SCANNED=true.
OCR_ENABLED=true
OCR_REJECT_SCANNED=false
# Process pool size. Leave at least 2 cores free (6 on an 8-core host).
OCR_WORKERS=6
OCR_DPI=120
# Pages with fewer text-layer chars than this are OCR candidates.
OCR_MIN_CHARS_FOR_TEXT=50
# A page counts as scanned only if its largest image covers this page fraction.
OCR_MIN_IMAGE_AREA_RATIO=0.9

# ---------- Feature flags ----------
# Semantic reranker. Needs a semantic plan on the search service: Free
# (1,000 queries/month, then 402 errors) or Standard (pay per query).
ENABLE_SEMANTIC_RANKING=true
# Create/update the index schema on boot. Set false for an index managed
# outside this app (e.g. a shared index, or one created via REST PUT).
ENSURE_INDEX_ON_STARTUP=true
